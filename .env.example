# =============================================================================
# REMNAWAVE TELEGRAM BOT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values

# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# Remnawave API Configuration
# For Docker deployment, use internal container name
API_BASE_URL=https://panel.remnawave.ru/api
# For external deployment, use your actual domain  
# API_BASE_URL=https://your-remnawave-panel.com/api
REMNAWAVE_API_TOKEN=your_api_token_here
# Optional: JSON object or cookie header string with session cookies
# Example: {"connect.sid":"s%3Aabcdef..."}
REMNAWAVE_COOKIES=

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Main menu title (displayed in the bot UI header)
MAIN_MENU_TITLE="Remnawave Admin"
# Toggle Inbounds management section (true/false)
INBOUNDS_MENU_ENABLED=false

# Super admin IDs (full access). Get your ID via @userinfobot
SUPER_ADMIN_USER_IDS=123456789
# Operator User IDs have read-only access (optional)
OPERATOR_USER_IDS=
# Path to SQLite DB that stores regular admins
ADMIN_DB_PATH="data/admins.db"

# Google Drive integration (required for subscription logging)
# Option 1: service account JSON (relative to project root)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json
# Option 2: OAuth flow
GOOGLE_OAUTH_CLIENT_SECRET_FILE=credentials/desktop-client.json
GOOGLE_OAUTH_TOKEN_FILE=credentials/google-oauth-token.json
# Target folder where per-user files will be created
GOOGLE_DRIVE_SUBSCRIPTIONS_FOLDER_ID=drive_folder_id_here

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Logging Level (ERROR, WARNING, INFO, DEBUG)
# For production use ERROR, for development use DEBUG
LOG_LEVEL=ERROR

# Environment (production, development, testing)
ENVIRONMENT=production

# =============================================================================
# DASHBOARD DISPLAY SETTINGS
# =============================================================================

# Control which information sections are displayed on the main screen
DASHBOARD_SHOW_SYSTEM_STATS=true      # Show system information (CPU, RAM, Uptime)
DASHBOARD_SHOW_SERVER_INFO=true       # Show server information
DASHBOARD_SHOW_USERS_COUNT=true       # Show user statistics
DASHBOARD_SHOW_NODES_COUNT=true       # Show node count
DASHBOARD_SHOW_TRAFFIC_STATS=true     # Show traffic statistics
DASHBOARD_SHOW_UPTIME=true            # Show system uptime

# =============================================================================
# SEARCH CONFIGURATION
# =============================================================================

# User search functionality settings
ENABLE_PARTIAL_SEARCH=true            # Enable partial name matching in user search
SEARCH_MIN_LENGTH=2                   # Minimum search query length

# These are automatically set by Docker Compose
# PYTHONUNBUFFERED=1

# =============================================================================
# EXAMPLE VALUES
# =============================================================================
# API_BASE_URL=https://panel.example.com/api
# REMNAWAVE_API_TOKEN=rmn_1234567890abcdef1234567890abcdef
# TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# SUPER_ADMIN_USER_IDS=123456789
# LOG_LEVEL=ERROR
# ENVIRONMENT=production

# User defaults
ACTIVE_INTERNAL_SQUADS=squadUUID

# Expiration notification settings
EXPIRATION_NOTIFICATION_ENABLED=true
EXPIRATION_NOTIFICATION_DAYS=3
EXPIRATION_NOTIFICATION_TIME=09:00
EXPIRATION_NOTIFICATION_TZ=GMT+5
